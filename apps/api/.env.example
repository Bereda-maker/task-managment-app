# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (matches docker-compose.yml `db` service) ---
DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard

# --- Auth ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS ---
# The EXACT origin of the web app. Never a wildcard.
FRONTEND_ORIGIN=http://localhost:5173

# --- Rate limiting (login attempts per IP) ---
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Set to true ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Optional ---
# Run pending migrations automatically at boot (handy on hosts without a release command)
MIGRATE_ON_START=false
# Override cookie SameSite. Defaults: Lax in development, None (with Secure) in production.
# COOKIE_SAMESITE=Lax
