# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (matches docker-compose.yml `db` service) ---
DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=15000

# --- Auth ---
# At least 32 characters, and NOT a placeholder — the app refuses to boot in production
# with anything matching /change-?me|example|secret-secret/i. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS / cookies ---
# The EXACT origin of the web app (scheme + host + port, no path). Never a wildcard.
# Required in production; defaults to http://localhost:5173 in development.
FRONTEND_ORIGIN=http://localhost:5173
# Override the cookie's SameSite. Defaults: Lax in development, None (+ Secure) in production.
# COOKIE_SAMESITE=Lax

# --- Rate limiting (per client IP, in-memory per process — see docs/SECURITY.md) ---
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
# Set to true ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Abuse guard ---
MAX_TASKS_PER_BOARD=1000

# --- Operations ---
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=10
# Run pending migrations automatically at boot (handy on hosts without a release command)
MIGRATE_ON_START=false
